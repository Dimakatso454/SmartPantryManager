<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pantry_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="15dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/my_pantry"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Pantry Summary -->
    <TextView
        android:id="@+id/textPantrySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Items: 0 | Expired: 0 | Expiring Soon: 0 | Fresh: 0"
        android:textSize="15sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="#E8F5E9"
        android:textColor="#1B5E20"
        android:layout_marginBottom="12dp" />

    <!-- Food Name -->
    <EditText
        android:id="@+id/editItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_food"
        android:inputType="textCapWords"
        android:minHeight="48dp" />

    <!-- Quantity -->
    <EditText
        android:id="@+id/editQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_quantity"
        android:inputType="number"
        android:minHeight="48dp" />

    <!-- Expiry Date -->
    <EditText
        android:id="@+id/editExpiryDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Expiry Date (YYYY-MM-DD)"
        android:inputType="date"
        android:focusable="false"
        android:clickable="true"
        android:minHeight="48dp" />

    <!-- Add Button -->
    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_item" />

    <!-- Search -->
    <EditText
        android:id="@+id/editSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search food items"
        android:inputType="text"
        android:minHeight="48dp"
        android:layout_marginTop="15dp" />

    <!-- Pantry List -->
    <ListView
        android:id="@+id/listPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
