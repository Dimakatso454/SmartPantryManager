<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="20dp">

    <!-- App Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- App Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage your food and reduce waste"
        android:textSize="14sp"
        android:textColor="#607D8B"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Pantry Summary -->
    <TextView
        android:id="@+id/textPantrySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Items: 0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:background="#E8F5E9"
        android:padding="16dp"
        android:layout_marginBottom="18dp" />

    <!-- Add Food Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Food Item"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#263238"
        android:layout_marginBottom="8dp" />

    <!-- Food Name -->
    <EditText
        android:id="@+id/editItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter food name"
        android:inputType="textCapWords"
        android:singleLine="true"
        android:minHeight="48dp"
        android:layout_marginBottom="8dp" />

    <!-- Quantity -->
    <EditText
        android:id="@+id/editQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter quantity"
        android:inputType="number"
        android:singleLine="true"
        android:minHeight="48dp"
        android:layout_marginBottom="8dp" />

    <!-- Expiry Date -->
    <EditText
        android:id="@+id/editExpiryDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Select expiry date"
        android:focusable="false"
        android:clickable="true"
        android:inputType="date"
        android:minHeight="48dp"
        android:layout_marginBottom="12dp" />

    <!-- Add Food Button -->
    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ADD FOOD ITEM"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="18dp" />

    <!-- My Pantry Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#263238"
        android:layout_marginBottom="6dp" />

    <!-- Search Food -->
    <EditText
        android:id="@+id/editSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search food items..."
        android:inputType="text"
        android:singleLine="true"
        android:minHeight="48dp"
        android:layout_marginBottom="10dp" />

    <!-- Sort Food Items -->
    <Spinner
        android:id="@+id/spinnerSort"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#2E7D32"
        android:contentDescription="Sort food items"
        android:layout_marginBottom="10dp" />

    <!-- Empty Pantry Message -->
    <TextView
        android:id="@+id/textEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Your pantry is empty.&#10;Add your first food item to get started!"
        android:textSize="17sp"
        android:textColor="#607D8B"
        android:textAlignment="center"
        android:visibility="gone"
        android:padding="20dp" />

    <!-- Pantry Food List -->
    <ListView
        android:id="@+id/listPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#CFD8DC"
        android:dividerHeight="1dp" />

</LinearLayout>
